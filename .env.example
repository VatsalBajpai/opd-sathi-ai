# OPD Saathi — OPTIONAL integrations only
# The full hackathon demo works with NO .env.local file.
# Copy this to .env.local only if you want the optional upgrades below.

# OPTIONAL: real open-ended Saathi AI. Without this, Saathi uses zero-key demo mode.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-6-luna

# OPTIONAL: Google account sign-in. Demo patient/staff login works without this.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Demo staff routing (optional; this default is already built into the app).
NEXT_PUBLIC_STAFF_EMAILS=staff@opdsaathi.demo

# OPTIONAL: Google Places + Google Maps Embed.
# Without these, hospital discovery/search uses OpenStreetMap/Nominatim/Overpass.
GOOGLE_MAPS_API_KEY=YOUR_SERVER_SIDE_GOOGLE_MAPS_KEY
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=YOUR_BROWSER_RESTRICTED_EMBED_KEY
